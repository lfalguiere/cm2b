# ─── CM2B — Variables d'environnement ───────────────────────────────────────
# Copier en .env.local pour le développement, .env pour la production.
# NE JAMAIS commiter .env ou .env.local dans le dépôt.

# ── Serveur ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Base de données ───────────────────────────────────────────────────────────
# Chemin vers le fichier SQLite (relatif à la racine du projet)
DB_PATH=./data/cm2b.sqlite
# Activer les logs SQL (true | false)
DB_LOGGING=false

# ── JWT ───────────────────────────────────────────────────────────────────────
# Secret de signature des access tokens.
# En production : générer avec `openssl rand -hex 64`
# MINIMUM 64 caractères, entropie élevée.
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_64_in_production

# ── CORS ─────────────────────────────────────────────────────────────────────
# URL exacte du frontend Angular (sans slash final)
FRONTEND_URL=http://localhost:4200
