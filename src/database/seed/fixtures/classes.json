      "maxLength": null,
      "defaultValue": null,
      "enumOptions": "[{\"value\":\"1\",\"label\":\"FAIBLE\",\"description\":\"Aucune obligation de traçabilité, pas de litige envisageable\",\"color\":\"#e8e8e8\",\"bgColor\":\"#016f01\"},{\"value\":\"2\",\"label\":\"MOYEN\",\"description\":\"Traçabilité utile en cas de contrôle interne, mais non critique\",\"color\":\"#e8e8e8\",\"bgColor\":\"#ad9601\"},{\"value\":\"3\",\"label\":\"ELEVE\",\"description\":\"Obligation réglementaire de journalisation, risque de litige ou d'audit externe\",\"color\":\"#e8e8e8\",\"bgColor\":\"#b76406\"},{\"value\":\"4\",\"label\":\"CRITIQUE\",\"description\":\"Obligation légale stricte (preuve judiciaire, conformité SOX/RGPD/NIS2), non-répudiation indispensable\",\"color\":\"#e8e8e8\",\"bgColor\":\"#940007\"}]"
