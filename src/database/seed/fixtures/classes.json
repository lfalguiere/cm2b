    {
      "className": "Macro-Processus",
      "name": "Besoin de disponibilité",
      "kind": "SIMPLE",
      "order": 0,
      "required": false,
      "description": "Que se passe-t-il si le processus est inaccessible ?",
      "simpleType": "ENUM",
      "validationRegex": null,
      "maxLength": null,
      "defaultValue": null,
      "enumOptions": "[{\"value\":\"1\",\"label\":\"FAIBLE\",\"description\":\"Interruption tolérée > 1 semaine, aucun impact opérationnel immédiat\",\"color\":\"#e8e8e8\",\"bgColor\":\"#016f0b\"},{\"value\":\"2\",\"label\":\"MOYEN\",\"description\":\"Interruption tolérée quelques jours, impact limité et récupérable\",\"color\":\"#faf4f4\",\"bgColor\":\"#ad9601\"},{\"value\":\"3\",\"label\":\"ELEVE\",\"description\":\"Interruption tolérée < 4h, impact significatif sur les missions\",\"color\":\"#e8e8e8\",\"bgColor\":\"#b76406\"},{\"value\":\"3\",\"label\":\"CRITIQUE\",\"description\":\"Interruption zéro tolérée, impact immédiat critique (vies, revenus, légal)\",\"color\":\"#e8e8e8\",\"bgColor\":\"#940007\"}]"
    },
    {
      "className": "Macro-Processus",
      "name": "Besoin de confidentialité",
      "kind": "SIMPLE",
      "order": 0,
      "required": false,
      "description": "Que se passe-t-il si la donnée traitée est divulguée ?",
      "simpleType": "ENUM",
      "validationRegex": null,
      "maxLength": null,
      "defaultValue": null,
      "enumOptions": "[{\"value\":\"1\",\"label\":\"FAIBLE\",\"description\":\"Données publiques ou à faible sensibilité, divulgation sans impact\",\"color\":\"#e8e8e8\",\"bgColor\":\"#016f01\"},{\"value\":\"2\",\"label\":\"MOYEN\",\"description\":\"Données internes, divulgation gênante mais sans conséquence grave\",\"color\":\"#e8e8e8\",\"bgColor\":\"#ad9601\"},{\"value\":\"3\",\"label\":\"ELEVE\",\"description\":\"Données  personnelles,  stratégiques, divulgation à impact juridique ou réputationnel fort\",\"color\":\"#e8e8e8\",\"bgColor\":\"#b76406\"},{\"value\":\"4\",\"label\":\"CRITIQUE\",\"description\":\"Données sensibles, propriété industrielle critique, divulgation catastrophique\",\"color\":\"#e8e8e8\",\"bgColor\":\"#940007\"}]"
    },
    {
      "className": "Macro-Processus",
      "name": "Besoin d'intégrité",
      "kind": "SIMPLE",
      "order": 0,
      "required": false,
      "description": "Que se passe-t-il si la donnée traitée est altérée ou corrompue ?",
      "simpleType": "ENUM",
      "validationRegex": null,
      "maxLength": null,
      "defaultValue": null,
      "enumOptions": "[{\"value\":\"1\",\"label\":\"FAIBLE\",\"description\":\"Erreur détectable facilement, sans conséquence majeure\",\"color\":\"#e8e8e8\",\"bgColor\":\"#016f01\"},{\"value\":\"2\",\"label\":\"MOYEN\",\"description\":\"Erreur difficile à détecter, impact limité et corrigeable\",\"color\":\"#e8e8e8\",\"bgColor\":\"#ad9601\"},{\"value\":\"3\",\"label\":\"ELEVE\",\"description\":\"Erreur grave, décisions erronées, impact financier ou juridique\",\"color\":\"#e8e8e8\",\"bgColor\":\"#b76406\"},{\"value\":\"4\",\"label\":\"CRITIQUE\",\"description\":\"Altération catastrophique, mise en danger de vies ou fraude massive\",\"color\":\"#e8e8e8\",\"bgColor\":\"#940007\"}]"
    },
